# Change all example credentials before exposing services outside your machine.
COMPOSE_PROJECT_NAME=rappi-stream

ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
ZOOKEEPER_HEAP_OPTS=-Xms256M -Xmx256M
KAFKA_INTERNAL_PORT=29092
KAFKA_BROKER_ID=1
KAFKA_HEAP_OPTS=-Xms512M -Xmx512M
KAFKA_TOPIC=order_events
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

RABBITMQ_DEFAULT_USER=rappi
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_DEFAULT_VHOST=/

POSTGRES_DB=rappistream
POSTGRES_USER=rappi
POSTGRES_PASSWORD=change-me

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=dashboard-aggregator
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=rappi
SPRING_RABBITMQ_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rappistream
SPRING_DATASOURCE_USERNAME=rappi
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8080
DASHBOARD_BACKEND_PORT=18080
DASHBOARD_AGGREGATOR_PORT=8081
DASHBOARD_INGEST_URL=ws://localhost:8080/ws/ingest
ORDER_API_PORT=8082
